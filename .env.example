# Copy to .env and edit. Never commit .env. No secrets belong in this file.
# The ECDS key is NOT stored here; it lives in ~/.cdsapirc.

# Local PostgreSQL (see database/README.md). Replace CHANGE_ME with your local password.
DATABASE_URL=postgresql+psycopg://sih:CHANGE_ME@localhost:5432/sih_rain

# Where cell-level Parquet files are kept (git-ignored)
DATA_DIR=./data

# Where trained model files are kept (git-ignored)
MODEL_DIR=./ml/models

# Model version served by the backend (set when models exist)
MODEL_VERSION=

# Optional, tests only: a PostgreSQL URL to also run the database tests on a real server (see backend/README.md)
# TEST_DATABASE_URL=postgresql+psycopg://sih@localhost:5432/sih_rain_test
